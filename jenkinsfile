pipeline {
    agent any

    tools {
        maven 'M3'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git 'https://github.com/karthikpyati777/Helllo-world-App.git'
            }
        }

        stage('Package the Application') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Image Creation') {
            steps {
                sh 'docker build -t karthik854/maven-web-app:v3 .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockercredid',
                    usernameVariable: 'dockerhubuser',
                    passwordVariable: 'dockerhubpass'
                )]) {
                    sh 'docker login -u ${dockerhubuser} -p ${dockerhubpass}'
                }
            }
        }

        stage('Push Image to DockerHub') {
            steps {
                sh 'docker push karthik854/maven-web-app:v3'
            }
        }

       stage('Deploy to Kubernetes') {
    steps {
        sh '''
        kubectl apply -f mavenwebapp-deployment.yaml
        kubectl get pods
        kubectl get svc
        '''
    }
}



    }
}
